generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  UNPAID
  PAID
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  businessName String?
  address      String?
  phone        String?
  invoices     Invoice[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@map("users")
}

model Invoice {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  invoiceDate    DateTime       @db.Date
  dueDate        DateTime       @db.Date
  status         InvoiceStatus  @default(UNPAID)
  notes          String?
  paymentTerms   String         @default("Net 15")
  currency       String         @default("EUR") @db.Char(3)
  fromName       String
  fromEmail      String
  fromAddress    String?
  fromPhone      String?
  clientName     String
  clientEmail    String?
  clientAddress  String?
  clientPhone    String?
  subtotalCents  Int
  taxTotalCents  Int
  totalCents     Int
  items          InvoiceItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, invoiceNumber])
  @@index([userId, status])
  @@index([userId, invoiceDate])
  @@index([userId, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @db.Uuid
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Decimal  @db.Decimal(12, 2)
  unitPriceCents Int
  taxPercent     Decimal  @db.Decimal(5, 2)
  lineTotalCents Int
  sortOrder      Int      @default(0)

  @@index([invoiceId])
  @@map("invoice_items")
}
